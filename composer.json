{
    "name": "mapo-89/laravel-homeassistant-api",
    "description": "Laravel package to interact with Home Assistant REST and WebSocket APIs.",
    "authors": [
        {
            "name": "Manuel Postler",
            "email": "info@postler.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/mapo-89/laravel-homeassistant-api",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^12.0|^13.0",
        "phrity/websocket": "^4.1",
        "spatie/laravel-package-tools": "^1.93.0"
    },
    "autoload": {
        "psr-4": {
            "Mapo89\\LaravelHomeassistantApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mapo89\\LaravelHomeassistantApi\\HomeassistantApiServiceProvider"
            ],
            "aliases": {
                "HomeassistantApi": "Mapo89\\LaravelHomeassistantApi\\Facades\\HomeassistantApi"
            }
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "check-style": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=768M",
        "check-autoload": "@composer dump-autoload --optimize --strict-psr --no-scripts",
        "qa": [
            "@check-composer",
            "@check-autoload",
            "@check-style",
            "@analyse",
            "@test",
            "@composer audit"
        ],
        "check-composer": "@composer validate --strict"
    }
}
