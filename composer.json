{
    "name": "mapo-89/laravel-homeassistant-api",
    "description": "Laravel package to interact with Home Assistant REST and WebSocket APIs.",
    "authors": [
        {
            "name": "Manuel Postler",
            "email": "info@postler.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/mapo-89/laravel-homeassistant-api",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "phrity/websocket": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Mapo89\\LaravelHomeassistantApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mapo89\\LaravelHomeassistantApi\\HomeassistantApiServiceProvider"
            ],
            "aliases": {
                "HomeassistantApi": "Mapo89\\LaravelHomeassistantApi\\Facades\\HomeassistantApi"
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    }
}
